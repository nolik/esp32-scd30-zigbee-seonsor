# Zigbee requires a 1000 Hz tick
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Real flash size of this board (sdkconfig of the C++ build wrongly said 2MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# esp-idf-sys resolves this relative to target/<triple>/<profile>/build/esp-idf-sys-*/out
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"

# ZCZR library: the device runs as a Zigbee router (ADR 0004)
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
